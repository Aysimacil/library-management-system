# Development settings. Supply production values through the deployment environment.
DJANGO_ENV=development
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TRUST_PROXY_HTTPS=false
HSTS_SECONDS=0
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
LIBRARY_CLOSED_DATES=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# Optional absolute path for persistent cover storage
# MEDIA_ROOT=/srv/library/media
