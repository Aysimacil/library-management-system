DJANGO_ENV=production
DEBUG=false
# Supply a new random secret via the service's private environment file.
SECRET_KEY=
ALLOWED_HOSTS=library.example.test
CSRF_TRUSTED_ORIGINS=https://library.example.test
MEDIA_ROOT=/srv/library/media
MEDIA_VOLUME_ID=library-covers
STATIC_ROOT=/srv/library/static
FILE_UPLOAD_TEMP_DIR=/srv/library/tmp
DB_ENGINE=postgresql
DB_NAME=library
DB_USER=library
DB_PASSWORD=
DB_HOST=database.example.test
DB_PORT=5432
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/library/database-ca.pem
EMAIL_MODE=smtp
DEFAULT_FROM_EMAIL=library@library.example.test
SMTP_SECURITY=starttls
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TRUST_PROXY_HTTPS=true
HSTS_SECONDS=0
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
PG_DUMP_PATH=/usr/bin/pg_dump
PG_RESTORE_PATH=/usr/bin/pg_restore
